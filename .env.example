# Token publico de leitura para uso no navegador (nunca use token iniciado por sk.)
MAPBOX_ACCESS_TOKEN=pk.SUBSTITUA_PELO_TOKEN_PUBLICO

# Estilo opcional. Se omitido, o gerador usa mapbox/light-v11.
MAPBOX_STYLE=mapbox://styles/mapbox/light-v11

# GreenField V4 - tabela SQL obrigatoria com exatamente 484 codigos unicos.
# Formatos aceitos: TABELA, SCHEMA.TABELA ou BANCO.SCHEMA.TABELA.
EXCLUDED_MUNICIPALITIES_TABLE=TESTE.dbo.MUNICIPIOS_EXCLUIDOS
EXCLUDED_MUNICIPALITIES_COLUMN=CD_MUNIC

# Solver V4 (padroes: 2 horas, gap 0,5%, execucao deterministica em uma thread).
GREENFIELD_V4_TIME_LIMIT=7200
GREENFIELD_V4_MIP_GAP=0.005
GREENFIELD_V4_SEED=20260812
GREENFIELD_V4_THREADS=1
