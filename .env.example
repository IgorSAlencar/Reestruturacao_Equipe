# Opcional: substitui o token publico padrao usado pelo mapa.
# Nunca informe aqui um token secreto iniciado por sk.
# MAPBOX_ACCESS_TOKEN=pk.SUBSTITUA_PELO_TOKEN_PUBLICO

# Estilo opcional. Se omitido, o gerador usa mapbox/light-v11.
MAPBOX_STYLE=mapbox://styles/mapbox/light-v11

# Aplicação web local
APP_HOST=10.206.168.97
WEB_PORT=5173
API_HOST=10.206.168.97
API_PORT=333
APP_DATA_DIR=.territorios-data
# Caminhos opcionais; por padrão são usadas as pastas das versões V3, V4 e V5.
OUTPUT_DIR=saida_greenfield_v3
OUTPUT_DIR_V4=saida_greenfield_v4
OUTPUT_DIR_V5=saida_greenfield_v5
# ARQUIVO_MUNICIPIOS_JSON=geometria_brasil/Brasil_Municipios.json
# ARQUIVO_DISTRITOS_JSON=geometria_brasil/Brasil_Distritos_Metro.json

# SQL Server — mesmos campos usados pelo mapa-hierarquia-visualiza.
# Mantenha usuário e senha somente no seu .env local.
SQL_SERVER=MZ-VV-BD-182
SQL_DATABASE=TESTE
SQL_USER=SEU_USUARIO
SQL_PASSWORD=SUA_SENHA
SQL_DOMAIN=CORP
SQL_INSTANCE=MSSQL2008A
SQL_TRUSTED_CONNECTION=true
SQL_ENCRYPT=false
SQL_TRUST_SERVER_CERTIFICATE=true
SQL_CONNECTION_TIMEOUT_MS=30000
SQL_REQUEST_TIMEOUT_MS=120000
PERIODO_LOJAS=202607

# GreenField V4/V5 - tabela SQL obrigatoria de municipios excluidos.
# A V5 usa o conteudo atual da tabela e nao congela a quantidade em 484.
# Formatos aceitos: TABELA, SCHEMA.TABELA ou BANCO.SCHEMA.TABELA.
EXCLUDED_MUNICIPALITIES_TABLE=TESTE.dbo.MUNICIPIOS_EXCLUIDOS
EXCLUDED_MUNICIPALITIES_COLUMN=CD_MUNIC

# Solver V4 (padroes: 2 horas, gap 0,5%, execucao deterministica em uma thread).
GREENFIELD_V4_TIME_LIMIT=7200
GREENFIELD_V4_MIP_GAP=0.005
GREENFIELD_V4_SEED=20260812
GREENFIELD_V4_THREADS=1
GREENFIELD_V4_MAX_CANDIDATES_PER_UNIT=24

# GreenField V5 heuristico, sem SCIP.
GREENFIELD_V5_REFINE_ITERATIONS=4
GREENFIELD_V5_SEED=20260813
GREENFIELD_V4_WARM_START_REPAIRS=20
